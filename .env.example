# ------------------------------------------------------------------
# Database — PostgreSQL on Supabase
# Supabase Dashboard -> your project -> Connect -> ORMs -> Prisma
# ------------------------------------------------------------------
# Pooled connection (Transaction pooler, port 6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Direct/session connection (port 5432), used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Auth.js (NextAuth v5): generate with `npx auth secret` or `openssl rand -base64 32`
# ------------------------------------------------------------------
AUTH_SECRET="<random-32-byte-secret>"

# ------------------------------------------------------------------
# Optional: AI Assistant (can also be configured in Admin -> Settings)
# ------------------------------------------------------------------
# AI_PROVIDER=""
# AI_MODEL=""
# AI_API_KEY=""
# AI_BASE_URL=""
# Key used to encrypt AI API keys stored in the database (falls back to AUTH_SECRET)
# AI_ENCRYPTION_KEY=""
