generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum FeeStatus {
  PAID
  PENDING
  PARTIAL
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  ACTIVE
  OVERDUE
  DRAFT
  COMPLETED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoticeAudience {
  EVERYONE
  TEACHERS
  STUDENTS
  PARENTS
  CLASS
}

model School {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communicationThreads CommunicationThread[]
  schoolPeriods        SchoolPeriod[]
  subjectAssignments   ClassSubjectAssignment[]
  teacherAttendances   TeacherAttendance[]
  users                User[]
  students             Student[]
  teachers             Teacher[]
  classes              Class[]
  subjects             Subject[]
  notices              Notice[]
  homeworks            Homework[]
  fees                 Fee[]
  exams                Exam[]
  tests                Test[]
  studyMaterials       StudyMaterial[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?

  role     Role    @default(STUDENT)
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacher Teacher?
  student Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threadsAsParticipantA CommunicationThread[]  @relation("CommunicationParticipantA")
  threadsAsParticipantB CommunicationThread[]  @relation("CommunicationParticipantB")
  sentMessages          CommunicationMessage[] @relation("CommunicationMessageSender")

  authoredNotices Notice[]  @relation("NoticeAuthors")
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// ACADEMICS & SCHOOL MANAGEMENT MODELS
// ==========================================

model Class {
  id       String @id @default(cuid())
  name     String // e.g. "1" or "9"
  section  String // e.g. "A" or "B"
  capacity Int    @default(30)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  students       Student[]
  teachers       Teacher[] @relation("ClassTeachers")
  classTeacherId String?
  classTeacher   Teacher?  @relation("ClassTeacherHead", fields: [classTeacherId], references: [id], onDelete: SetNull)

  subjectAssignments ClassSubjectAssignment[]
  subjects           Subject[]
  timetables         TimetableSlot[]
  homeworks          Homework[]
  exams              Exam[]
  tests              Test[]
  studyMaterials     StudyMaterial[]
  attendances        Attendance[]
  targetedNotices    Notice[]                 @relation("TargetedNotices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, section, schoolId])
}

model Student {
  id        String    @id @default(cuid())
  studentId String    @unique // e.g. STU-2026-0007
  rollNo    String?
  dob       DateTime?
  address   String?

  // Parent / Guardian details
  parentName  String?
  parentPhone String?
  parentEmail String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  attendances Attendance[]
  fees        Fee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id            String  @id @default(cuid())
  teacherId     String  @unique // e.g. TCH-2026-0038
  phone         String?
  qualification String?
  experience    String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjectAssignments ClassSubjectAssignment[]
  classes            Class[]                  @relation("ClassTeachers")
  headOfClasses      Class[]                  @relation("ClassTeacherHead")
  subjects           Subject[]
  teacherAttendances TeacherAttendance[]

  timetables     TimetableSlot[]
  homeworks      Homework[]
  studyMaterials StudyMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String  @id @default(cuid())
  name        String // e.g. "Mathematics"
  code        String // e.g. "MATH"
  description String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjectAssignments ClassSubjectAssignment[]
  classes            Class[]
  teachers           Teacher[]
  attendances        Attendance[]

  timetables     TimetableSlot[]
  homeworks      Homework[]
  tests          Test[]
  studyMaterials StudyMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, schoolId])
}

// 1. Update the existing Attendance model to support optional subjects
model Attendance {
  id     String           @id @default(cuid())
  date   DateTime
  status AttendanceStatus @default(PRESENT)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  // NEW: Optional subject relation for subject-wise attendance
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date, subjectId]) // Updated unique constraint
}

// 2. Add this NEW model for Teacher Attendance
model TeacherAttendance {
  id     String           @id @default(cuid())
  date   DateTime
  status AttendanceStatus @default(PRESENT)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
}

model Fee {
  id          String    @id @default(cuid())
  title       String // e.g. "Tuition Fee - Term 1"
  totalAmount Float
  paidAmount  Float     @default(0)
  dueDate     DateTime
  status      FeeStatus @default(PENDING)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  payments FeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeePayment {
  id          String   @id @default(cuid())
  receiptNo   String   @unique
  amount      Float
  paymentMode String // Cash, Online, Cheque
  referenceNo String?
  paidAt      DateTime @default(now())

  feeId String
  fee   Fee    @relation(fields: [feeId], references: [id], onDelete: Cascade)
}

model Homework {
  id          String           @id @default(cuid())
  title       String
  description String?          @db.Text
  dueDate     DateTime
  status      AssignmentStatus @default(ACTIVE)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimetableSlot {
  id        String  @id @default(cuid())
  day       String // e.g. "Monday"
  period    String // e.g. "Period 1"
  startTime String // e.g. "08:00"
  endTime   String // e.g. "08:45"
  isBreak   Boolean @default(false)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  priority    Priority       @default(MEDIUM)
  status      NoticeStatus   @default(PUBLISHED)
  audience    NoticeAudience @default(EVERYONE)

  author     String
  authorId   String?
  authorUser User?   @relation("NoticeAuthors", fields: [authorId], references: [id], onDelete: SetNull)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId String?
  class   Class?  @relation("TargetedNotices", fields: [classId], references: [id], onDelete: SetNull)

  isPinned  Boolean   @default(false)
  publishAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status, publishAt])
  @@index([schoolId, audience])
  @@index([classId])
}

model Test {
  id         String   @id @default(cuid())
  title      String // e.g. "Unit Test 2"
  totalMarks Int
  duration   Int // in minutes
  date       DateTime
  status     String   @default("Scheduled") // Scheduled, Completed

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id        String   @id @default(cuid())
  title     String // e.g. "Term 1 Examination"
  examType  String // e.g. "Annual Exam", "Mid Term"
  startDate DateTime
  endDate   DateTime
  status    String   @default("Scheduled")

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyMaterial {
  id          String  @id @default(cuid())
  title       String
  type        String // "Worksheet", "Notes", "Paper", "Pdf"
  description String?
  fileUrl     String?
  downloads   Int     @default(0)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSubjectAssignment {
  id        String  @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String
  teacherId String?

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([schoolId, classId])
  @@index([schoolId, teacherId])
}

model SchoolPeriod {
  id        String  @id @default(cuid())
  schoolId  String
  name      String
  startTime String
  endTime   String
  sortOrder Int     @default(0)
  isBreak   Boolean @default(false)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

model CommunicationThread {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  participantAId String
  participantBId String

  participantA User @relation("CommunicationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User @relation("CommunicationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  messages CommunicationMessage[]

  lastMessageAt DateTime?
  readAtA       DateTime?
  readAtB       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, participantAId, participantBId])
  @@index([schoolId, lastMessageAt])
  @@index([participantAId])
  @@index([participantBId])
}

model CommunicationMessage {
  id String @id @default(cuid())

  threadId String
  thread   CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("CommunicationMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
}
